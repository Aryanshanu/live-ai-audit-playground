# Copy to .env.local (already gitignored) and fill in the real value.
#
# IMPORTANT for a static export (output: 'export' in next.config.mjs):
# NEXT_PUBLIC_* variables are baked in at BUILD time, not read at
# runtime. Changing this after `npm run build` has no effect until you
# rebuild — there's no server here to read env vars live.
#
# Placeholder until services/rai-agent is actually deployed via
# `flyctl deploy` (see services/rai-agent/README.md). Until then, any
# code calling src/lib/api/raiEngine.js will throw a clear "not
# configured" error rather than silently failing against a fake URL.
NEXT_PUBLIC_RAI_ENGINE_URL=
